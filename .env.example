# ==========================================
# Food Waste Donation & Distribution Platform
# Example Environment Configuration (.env)
# ==========================================

# PostgreSQL Connection Variables
DB_HOST=localhost
DB_PORT=5433
DB_NAME=food_waste_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Initial Admin Bootstrap Credentials
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_NAME=Platform Super Admin
ADMIN_EMAIL=admin@foodwaste.org
ADMIN_PASSWORD=SetAStrongPasswordHere!2026
ADMIN_PHONE=+919876543210

# Upload Directory
UPLOAD_DIR=uploads/images
